{
  "name": "open-banking-chile",
  "version": "2.0.0",
  "description": "Scrapers open source para bancos chilenos. Obtén tus movimientos y saldo como JSON. Open source scrapers for Chilean banks.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "open-banking-chile": "dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "open-banking",
    "chile",
    "bank-scraper",
    "finanzas",
    "banking",
    "scraper",
    "puppeteer",
    "banco-falabella",
    "banco-chile",
    "santander",
    "bci",
    "banco-estado",
    "movimientos",
    "cartola"
  ],
  "author": "Kai Horwitz <kai@makana.cl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaihv/open-banking-chile.git"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "playwright-core": "^1.59.1",
    "puppeteer-core": "^25.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": false
  }
}
